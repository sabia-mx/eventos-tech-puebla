---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/familjen-grotesk';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  timezone: string;
}

const { title, description, timezone } = Astro.props;
---

<!doctype html>
<html lang="es-MX" data-timezone={timezone}>
  <head>
    <script is:inline>
      document.documentElement.classList.add('agenda-booting');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#registro">Saltar al registro</a>
    <slot />
  </body>
</html>
